# 운영 서버의 배포 디렉터리에 app.env로 복사해 값을 채운다. 저장소에 커밋하지 않는다.
# DB 호스트는 postgresql 네트워크 안의 PostgreSQL 컨테이너 이름이다.
DB_URL=jdbc:postgresql://postgresql:5432/oss-eol
DB_USERNAME=oss-eol
DB_PASSWORD=
# Azure OpenAI v1 엔드포인트(내부 게이트웨이라면 그 주소)와 API 키
OPENAI_BASE_URL=https://<리소스>.openai.azure.com/openai/v1
AZURE_OPENAI_KEY=
# 배포 이름. 추론 모델이면 EOL_AI_EFFORT(low/medium/high)도 정한다
EOL_AI_MODEL=gpt-4.1
EOL_AI_EFFORT=
# AI 추출 호출의 max_completion_tokens. 모델의 최대 출력 토큰을 넘지 않게 한다(GPT-4o 16384, GPT-4.1 32768)
EOL_AI_MAXTOKENS=32000
# 출처(endoflife.date)로 나가는 요청이 프록시를 거쳐야 하면 JVM 옵션으로 지정한다
# JAVA_TOOL_OPTIONS=-Dhttps.proxyHost=proxy.example -Dhttps.proxyPort=8080
# 프런트엔드가 서비스되는 origin (쉼표로 여러 개). API는 oss-eol-api.jjoon.cloud, 프런트엔드는 oss-eol.jjoon.cloud로 가정
EOL_CORS_ALLOWED_ORIGINS=https://oss-eol.jjoon.cloud
TZ=Asia/Seoul
